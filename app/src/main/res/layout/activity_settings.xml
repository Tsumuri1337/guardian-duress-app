<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ===== Hardware button ===== -->
        <LinearLayout style="@style/RowContainer">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/section_hardware" />
                <TextView style="@style/RowSub" android:text="@string/hw_sub" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swHardware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <Button
            android:id="@+id/btnConfigHardware"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure"
            android:visibility="gone" />

        <!-- ===== Quick Settings tile ===== -->
        <LinearLayout style="@style/RowContainer">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/section_tile" />
                <TextView style="@style/RowSub" android:text="@string/qs_sub" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swQsTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <Button
            android:id="@+id/btnConfigQs"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure"
            android:visibility="gone" />

        <!-- ===== Decoy PIN ===== -->
        <LinearLayout style="@style/RowContainer">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/section_decoy" />
                <TextView style="@style/RowSub" android:text="@string/decoy_sub" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDecoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <Button
            android:id="@+id/btnConfigDecoy"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure"
            android:visibility="gone" />

        <!-- ===== Alert delivery (shared config, always available) ===== -->
        <LinearLayout style="@style/RowContainer">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/section_alert_delivery" />
                <TextView style="@style/RowSub" android:text="@string/alert_sub" />
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/btnConfigAlert"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure" />

        <!-- ===== Inactivity auto-wipe ===== -->
        <LinearLayout style="@style/RowContainer">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/section_inactivity" />
                <TextView style="@style/RowSub" android:text="@string/inactivity_sub" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swInactivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <Button
            android:id="@+id/btnConfigInactivity"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
