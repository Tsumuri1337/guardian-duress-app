<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbDeadman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_deadman" />

            <RadioButton
                android:id="@+id/rbFixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_fixed" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/duration_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etDays"
                style="@style/TimeField"
                android:hint="@string/d" />

            <TextView style="@style/TimeColon" android:text=":" />

            <EditText
                android:id="@+id/etHours"
                style="@style/TimeField"
                android:hint="@string/h" />

            <TextView style="@style/TimeColon" android:text=":" />

            <EditText
                android:id="@+id/etMinutes"
                style="@style/TimeField"
                android:hint="@string/m" />

            <TextView style="@style/TimeColon" android:text=":" />

            <EditText
                android:id="@+id/etSeconds"
                style="@style/TimeField"
                android:hint="@string/s" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dhms_hint"
            android:textSize="12sp"
            android:alpha="0.7" />

        <Button
            android:id="@+id/btnReset"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/responses_header"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resp_alert" />

        <CheckBox
            android:id="@+id/cbCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resp_capture" />

        <CheckBox
            android:id="@+id/cbWipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resp_wipe" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resp_wipe_warn"
            android:textColor="#C62828"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
